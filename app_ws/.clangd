# clangd 配置:指向 app_ws(自研 overlay)的编译数据库
# 由 app_ws/build/*/compile_commands.json 合并生成,覆盖自研 C++ 包
# (cos_shape)。厂家驱动层见仓库根目录的 .clangd。
# 合并命令(在 app_ws/ 下执行,与 .vscode/tasks.json 中 elfin_ws 的做法相同):
#   python3 -c "import json,glob; m=[]; [m.extend(json.load(open(p))) for p in glob.glob('build/*/compile_commands.json')]; json.dump(m, open('build/compile_commands.json','w'), indent=1)"
CompileFlags:
  CompilationDatabase: build

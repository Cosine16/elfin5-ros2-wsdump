<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Approximate D435i housing: 90 x 25 x 25 mm, 72 g. REP-103 body axes.
       RGB/depth are ideal, co-located simulation sensors, not factory intrinsics. -->
  <xacro:macro name="d435i" params="parent xyz rpy">
    <joint name="camera_mount_joint" type="fixed">
      <parent link="${parent}"/><child link="camera_link"/><origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
    <link name="camera_link">
      <visual><geometry><box size="0.025 0.09 0.025"/></geometry>
        <material name="camera_silver"><color rgba="0.7 0.72 0.75 1"/></material></visual>
      <visual><origin xyz="0.0126 0 0"/><geometry><box size="0.001 0.084 0.02"/></geometry>
        <material name="camera_face"><color rgba="0.02 0.02 0.02 1"/></material></visual>
      <collision><geometry><box size="0.025 0.09 0.025"/></geometry></collision>
      <inertial><mass value="0.072"/>
        <inertia ixx="0.00005235" iyy="0.0000075" izz="0.00005235" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <xacro:macro name="optical_frame" params="kind">
      <link name="camera_${kind}_frame"/>
      <joint name="camera_${kind}_joint" type="fixed">
        <parent link="camera_link"/><child link="camera_${kind}_frame"/><origin xyz="0.013 0 0"/>
      </joint>
      <link name="camera_${kind}_optical_frame"/>
      <joint name="camera_${kind}_optical_joint" type="fixed">
        <parent link="camera_${kind}_frame"/><child link="camera_${kind}_optical_frame"/>
        <origin rpy="${-pi/2} 0 ${-pi/2}"/>
      </joint>
    </xacro:macro>
    <xacro:optical_frame kind="color"/>
    <xacro:optical_frame kind="depth"/>
    <link name="camera_imu_frame"/>
    <joint name="camera_imu_joint" type="fixed"><parent link="camera_link"/><child link="camera_imu_frame"/></joint>
    <gazebo reference="camera_link">
      <sensor name="d435i_rgbd" type="rgbd_camera">
        <pose>0.013 0 0 0 0 0</pose>
        <topic>/camera</topic><gz_frame_id>camera_color_optical_frame</gz_frame_id>
        <always_on>true</always_on><update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.211259</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>5.0</far></clip>
        </camera>
      </sensor>
      <sensor name="d435i_imu" type="imu">
        <topic>/camera/imu</topic><gz_frame_id>camera_imu_frame</gz_frame_id>
        <always_on>true</always_on><update_rate>100</update_rate>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>

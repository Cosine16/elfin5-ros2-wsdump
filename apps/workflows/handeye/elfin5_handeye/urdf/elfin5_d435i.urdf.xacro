<?xml version="1.0"?>
<robot name="elfin5" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Reuse the manufacturer's kinematics, meshes and Harmonic control interface. -->
  <xacro:include filename="$(find elfin5_gz_sim)/urdf/elfin5.urdf.xacro"/>
  <xacro:include filename="$(find elfin5_handeye)/urdf/d435i.xacro"/>
  <xacro:arg name="mount_xyz" default="0 0 0.07"/>
  <xacro:arg name="mount_rpy" default="0 -1.5707963267948966 0"/>
  <link name="camera_bracket">
    <visual><origin xyz="0 0 0.025"/><geometry><cylinder radius="0.02" length="0.05"/></geometry>
      <material name="bracket"><color rgba="0.25 0.25 0.25 1"/></material></visual>
    <collision><origin xyz="0 0 0.025"/><geometry><cylinder radius="0.02" length="0.05"/></geometry></collision>
    <inertial><origin xyz="0 0 0.025"/><mass value="0.05"/>
      <inertia ixx="0.0000154" iyy="0.0000154" izz="0.00001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="camera_bracket_joint" type="fixed"><parent link="elfin_end_link"/><child link="camera_bracket"/></joint>
  <xacro:d435i parent="elfin_end_link" xyz="$(arg mount_xyz)" rpy="$(arg mount_rpy)"/>
</robot>

<?xml version="1.0" ?>

<!-- cos_rsvisual/worlds/elfin5_actor.world
     基于 elfin5_ros2_gazebo/worlds/elfin5.world (sun + ground_plane),
     追加一个行走假人 actor: 使用 gazebo11 自带 walk.dae,
     沿半径 0.5m 的圆轨迹循环行走, 圆心在机械臂前方 (2.0, 0, 0)。
     若 actor 动画在某些 gazebo 版本不正常, 可退而用圆柱体 model +
     ros2 service call /gazebo/set_entity_state 移动它。 -->

<sdf version="1.6">
  <world name="default">

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 行走假人: 圆轨迹中心 (2.0, 0, 0), 半径 0.5m。
         轨迹选取说明: 相机装在末端, home 位姿下位于 z≈1.2m 朝世界 +X 看;
         地面恰好在 3.0m 外出现, 检测距离带上限设为 2.9m 即可天然排除地面,
         该圆轨迹 (距相机 1.9~2.8m, 方位角 ±15°内) 稳定落在视野与距离带中。 -->
    <actor name="walker">
      <pose>2.5 0.0 0.0 0 0 1.5708</pose>
      <skin>
        <filename>file://media/models/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>file://media/models/walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <!-- 逆时针圆周: (2.5,0)->(2,0.5)->(1.5,0)->(2,-0.5)->(2.5,0), yaw 沿切向 -->
          <waypoint>
            <time>0.0</time>
            <pose>2.5 0.0 0.0 0 0 1.5708</pose>
          </waypoint>
          <waypoint>
            <time>1.57</time>
            <pose>2.0 0.5 0.0 0 0 3.1416</pose>
          </waypoint>
          <waypoint>
            <time>3.14</time>
            <pose>1.5 0.0 0.0 0 0 -1.5708</pose>
          </waypoint>
          <waypoint>
            <time>4.71</time>
            <pose>2.0 -0.5 0.0 0 0 0.0</pose>
          </waypoint>
          <waypoint>
            <time>6.28</time>
            <pose>2.5 0.0 0.0 0 0 1.5708</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

  </world>
</sdf>

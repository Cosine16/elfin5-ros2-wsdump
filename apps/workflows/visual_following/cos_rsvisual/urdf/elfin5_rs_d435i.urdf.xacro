  <!-- ================= D435i 相机(眼在手上, cos_rsvisual 追加) ================= -->
  <!-- 眼在手上的手眼标定外参入口:
       真机做完手眼标定后, 改 launch 传入的 mount_xyz / mount_rpy 即可,
       不必改动本文件其余部分。默认值为相机装在 elfin_end_link 正上方 2cm。 -->
  <xacro:arg name="mount_xyz" default="0 0 0.02" />
  <xacro:arg name="mount_rpy" default="0 0 0" />

  <!-- 简化 D435i 模型: box 0.025(x) x 0.09(y) x 0.025(z), 质量 0.072kg。
       不依赖 realsense2_description, 仿真足够用。 -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.072" />
      <!-- 均匀长方体惯性: ixx=m/12*(y^2+z^2), iyy=m/12*(x^2+z^2), izz=m/12*(x^2+y^2) -->
      <inertia ixx="5.235e-05" ixy="0.0" ixz="0.0"
               iyy="7.5e-06" iyz="0.0" izz="5.235e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.09 0.025" />
      </geometry>
      <material name="">
        <color rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.09 0.025" />
      </geometry>
    </collision>
  </link>

  <!-- 相机固定安装到末端法兰 -->
  <joint name="camera_mount_joint" type="fixed">
    <origin xyz="$(arg mount_xyz)" rpy="$(arg mount_rpy)" />
    <parent link="elfin_end_link" />
    <child link="camera_link" />
  </joint>

  <!-- 深度帧(物理帧) -->
  <link name="camera_depth_frame"/>
  <joint name="camera_depth_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="camera_link" />
    <child link="camera_depth_frame" />
  </joint>

  <!-- 标准 optical 帧: z 轴朝镜头前方, x 右 y 下 -->
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708" />
    <parent link="camera_depth_frame" />
    <child link="camera_depth_optical_frame" />
  </joint>

  <!-- gazebo 深度相机插件 (ros-foxy-gazebo-plugins 提供 libgazebo_ros_camera.so)。
       foxy 插件话题命名规则: <namespace>/<camera_name>/...
       此处 namespace=/, camera_name=camera, 实际话题:
         深度图(32FC1, 单位米): /camera/depth/image_raw
         深度相机内参:          /camera/depth/camera_info
         点云:                  /camera/points
       点云与深度图 frame_id 均为 camera_depth_optical_frame。
       注意: 仿真深度图是 32FC1(米), 真机 realsense 是 16UC1(毫米),
       cos_rsvisual 的检测组件两种编码都支持。 -->
  <gazebo reference="camera_depth_frame">
    <sensor name="camera_depth" type="depth">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>false</visualize>
      <camera name="camera_depth_camera">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.3</near>
          <far>5.0</far>
        </clip>
      </camera>
      <plugin name="camera_depth_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_depth_optical_frame</frame_name>
        <min_depth>0.3</min_depth>
        <max_depth>5.0</max_depth>
        <pointCloudCutoff>0.3</pointCloudCutoff>
      </plugin>
    </sensor>
  </gazebo>

</robot>
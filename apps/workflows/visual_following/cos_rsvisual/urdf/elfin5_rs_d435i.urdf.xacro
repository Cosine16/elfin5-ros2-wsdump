<?xml version="1.0"?>

<!--
  =============================================================================
  cos_rsvisual/urdf/elfin5_rs_d435i.urdf.xacro

  本文件同步自 elfin5_ros2_gazebo/urdf/elfin5.urdf.xacro(完整拷贝),
  末尾追加了 RealSense D435i 相机模型(link/joint + gazebo 深度相机插件)。
  上游(elfin5_ros2_gazebo)URDF 若有变更,需手动同步本文件的拷贝部分。

  与原版差异:
    1) 末尾追加 camera_link / camera_depth_frame / camera_depth_optical_frame
       及 camera_mount_joint(眼在手上外参入口)。
    2) 末尾追加 gazebo 深度相机插件(libgazebo_ros_camera.so, type="depth")。
    3) 新增 xacro arg: mount_xyz / mount_rpy(手眼标定外参)。

  仿真 launch 中务必传: use_real_hardware:=false use_fake_hardware:=false
  =============================================================================
-->

<robot name="elfin5" xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:arg name="use_real_hardware" default="true" />
  <xacro:arg name="use_fake_hardware" default="false" />

  <!-- Load TRANSMISSION file: -->
  <xacro:include filename="$(find elfin5_ros2_gazebo)/urdf/elfin5_transmission.xacro" />
  <!-- Load GAZEBO/ROS2_CONTROL file: -->
  <xacro:include filename="$(find elfin5_ros2_gazebo)/urdf/elfin5_gazebo.xacro" />
 
  <xacro:property name="PI" value="3.1415926535897931"/>
  
  <xacro:property name="density" value="3.09"/>
    
    <!-- TRANSMISSION: -->
    <xacro:elfin5_transmission />
    <!-- GAZEBO - ROS2_CONTROL: -->
    <xacro:elfin5_gazebo  
    use_real_hardware="$(arg use_real_hardware)" 
    use_fake_hardware="$(arg use_fake_hardware)"/>
    
  <link name="world"/>
  
  <joint name="world_base" type="fixed">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent
      link="world" />
    <child
      link="elfin_base_link" />
  </joint>
  
  <link name="elfin_base_link"/>
  

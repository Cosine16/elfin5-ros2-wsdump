<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cos_rsvisual</name>
  <version>0.1.0</version>
  <description>
    RealSense D435i 视觉感知 + Elfin5 视觉跟随包(眼在手上)。
    包含:深度/视觉人体检测组件(person_depth_detector / person_visual_detector)、
    末端跟随组件(arm_follower,发布 /cart_goal 给 elfin_basic_api_node)、
    带 D435i 相机的 elfin5 仿真 URDF、MoveIt octomap 配置与一键仿真 launch。
  </description>
  <maintainer email="2395058425@qq.com">xtsinghang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_geometry</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>OpenCV</depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>elfin5_ros2_gazebo</exec_depend>
  <exec_depend>elfin5_ros2_moveit2</exec_depend>
  <exec_depend>elfin_basic_api</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

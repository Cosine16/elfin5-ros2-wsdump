<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>elfin_demo</name>
  <version>0.1.0</version>
  <description>
    Elfin 机械臂 ROS2 控制接口示例（移植自官方 ROS1 ros_demo.zip 中的 elfin_ros_demo）。
    接口名对应当前工作区的 ROS2 版 elfin_basic_api / elfin_ethercat_driver。
  </description>
  <maintainer email="2395058425@qq.com">xtsinghang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>elfin_robot_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

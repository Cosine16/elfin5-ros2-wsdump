# Vendor compilation databases; application overrides are in apps/.clangd.
CompileFlags:
  CompilationDatabase: .build/vendor/build
---
If:
  PathMatch: third_party/elfin_robot_ros2/elfin_basic_api/.*
CompileFlags:
  CompilationDatabase: .build/vendor/build/elfin_basic_api
---
If:
  PathMatch: third_party/elfin_robot_ros2/elfin_ethercat_driver/.*
CompileFlags:
  CompilationDatabase: .build/vendor/build/elfin_ethercat_driver
---
If:
  PathMatch: third_party/elfin_robot_ros2/elfin_ros_control/.*
CompileFlags:
  CompilationDatabase: .build/vendor/build/elfin_ros_control
---
If:
  PathMatch: third_party/elfin_robot_ros2/soem_ros2/.*
CompileFlags:
  CompilationDatabase: .build/vendor/build/soem_ros2
